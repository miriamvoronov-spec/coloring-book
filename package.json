{
  "name": "miriam-coloring-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/artifact.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdfjs-dist": "^3.11.174"
  }
}
